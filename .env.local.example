# 1. Copie este arquivo para .env.local (o Next.js NÃO lê o .example)
# 2. Preencha com Supabase Dashboard → Settings → API
# 3. Reinicie: npm run dev

NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon_publica

# Mercado Pago (Planos — Pix, cartão avulso e recorrente)
# https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
# true = credenciais de teste (Checkout Pro + cartões de teste)
MERCADOPAGO_TEST=true
# Opcional: e-mail de um comprador criado em Contas de teste
# MERCADOPAGO_TEST_BUYER_EMAIL=TESTUSER...@testuser.com
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-...
# Webhook: https://www.toqtennis.com.br/api/billing/webhook
# Cron horário (expiração + lembrete 3 dias): /api/billing/cron
# Na Vercel, defina CRON_SECRET e Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Lembretes de renovação (opcional — mesma conta Resend do Auth)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Toq Tennis <noreply@mail.toqtennis.com.br>

# Stripe (legado — substituído pelo Mercado Pago; pode remover depois)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# URL pública do app (produção: https://www.toqtennis.com.br)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare (opcional — scripts/setup-cloudflare.mjs)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE=toqtennis.com.br
# VERCEL_DNS_TARGET=cname.vercel-dns.com

# Supabase service role (webhook/checkout — NUNCA no cliente, NUNCA no .example)
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key
# https://console.cloud.google.com/ — ative Maps JavaScript API + Places API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=sua_chave_google_maps
